msgid "Custom Forms - Dawa Address field"
msgstr "Tilpassede formularer - Dawa adresse felt"

msgid "Adds a Dawa address field to custom forms."
msgstr "Tilføjer et dawa adresse felt til tilpassede formularer."

msgid "DAWA Autocomplete address"
msgstr "DAWA Autofuldført adresse"

msgid "An address field that autocompletes itself based on the danish address registry."
msgstr "Et adressefelt der autofuldfører sig selv baseret på det danske adresse register."

msgid "Invalid address selected, please try again."
msgstr "Ugyldig adresse valgt, prøv venligst igen."

msgid "Use as invoice address."
msgstr "Anvend som faktureringsadresse."

msgid "Use the entered address as the invoicing address, if multiple addresses are marked for use as invoicing only the first is used."
msgstr "Brug den indtastede adresse som faktureringsadresse, hvis flere adresser er markeret til brug som faktureringsadresse bliver den første brugt."

msgid "Default value"
msgstr "Standard værdi"

msgid "Controls the default value of the field."
msgstr "Kontrollerer standard værdien af feltet."

msgid "Use as primary address."
msgstr "Anvend som primær adresse."

msgid "Use the value submitted to this field as the primary address for the submission."
msgstr "Anvend værdien indsendt på dette felt, som den primære adresse for indsendelsen."

msgid "Denmark"
msgstr "Danmark"
